# MySQL Database Configuration
MYSQL_HOST=your-mysql-host.example.edu.in
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=helpdesk
# Institutional Database Configuration:
# On hosts where `helpdesk` contains local SQL SECURITY DEFINER views of institutional tables
# (teacher_info, branch_detail, location), this value MUST equal MYSQL_DATABASE (e.g. 'helpdesk')
# so queries use the local views without cross-database permissions issues.
# If institutional tables reside in a separate database with direct grant permissions, specify that name.
MYSQL_INSTITUTIONAL_DATABASE=helpdesk
MYSQL_PORT=3306

# Database Connection Pool & Resilience Configuration
# MYSQL_POOL_MAXSIZE: Max pooled connections per worker process (default: 20, was 10).
# In production with 2 Granian workers: 2 workers × 20 = 40 max pooled connections,
# well under MySQL server max_connections=151 (leaving ample headroom for admin tools).
MYSQL_POOL_MAXSIZE=20
# MYSQL_POOL_WAIT: Max bounded wait in seconds for an available pooled connection before fallback (default: 5.0, clamped 1.0-15.0s).
MYSQL_POOL_WAIT=5.0
# MYSQL_IDLE_TTL: Max idle connection lifetime in seconds before eviction/ping check by pool sweeper (default: 240.0s).
MYSQL_IDLE_TTL=240.0

# Secret key for sessions (can be generated using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Set to 'false' to skip demo schema initialization on startup
INIT_DEMO_DB=true

# SMTP Mail Server Configuration
SMTP_HOST=mail.sreenidhi.edu.in
SMTP_PORT=587
SMTP_USER=support.helpdesk@sreenidhi.edu.in
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_SENDER=support.helpdesk@sreenidhi.edu.in

# SMS and WhatsApp HTTP API Configuration
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER=SNISTA
SMS_TEST_NUMBER=

# WhatsApp API Configuration (Unified Messaging Platform)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://103.229.250.150/unified/v2/send
WHATSAPP_CLIENT_ID=your_whatsapp_client_id
WHATSAPP_CLIENT_PASSWORD=your_whatsapp_client_password
WHATSAPP_TEMPLATE_ID=1773697
WHATSAPP_FROM_NUMBER=919133386678

# Bypass logging for Bulk SMS and WhatsApp API requests/responses
BYPASS_SMS_WHATSAPP_LOGS=false

# Google Workspace SSO Configuration
SSO_ENABLED=true
SSO_PROVIDER=google
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_HOSTED_DOMAIN=sreenidhi.edu.in
# SSO_REDIRECT_URI=http://localhost:5000/sso/callback

# Metabase Analytics Configuration
METABASE_SITE_URL=https://metabase.example.edu.in
METABASE_INTERNAL_URL=http://localhost:3000
METABASE_SECRET_KEY=your_metabase_hex_secret_key
METABASE_DASHBOARD_OVERVIEW=2
METABASE_DASHBOARD_TRENDS=3
METABASE_DASHBOARD_CA_PERF=4

# Metabase Admin Credentials (used by scripts/configure_metabase.py)
MB_ADMIN_EMAIL=admin@sreenidhi.edu.in
MB_ADMIN_PASSWORD=your_secure_metabase_password

# Security & Rate Limiting Configuration (Phase 6)
LOGIN_MAX_ATTEMPTS_USER=5
LOGIN_MAX_ATTEMPTS_IP=30
LOGIN_WINDOW_MINUTES=15
PERMANENT_SESSION_LIFETIME_HOURS=8
SESSION_COOKIE_SECURE=false
UPLOAD_MAX_MB=10



